From: Nick Matteo <nickmatteo@users.noreply.github.com>
Date: Sat, 5 Sep 2026 18:34:48 -0400
Subject: [PATCH 19/24] test: opt-in Qwen sidecar borrowing of target embedding
 and output

---
 src/llama-context.cpp   | 28 ++++++++++++++++++++++++++++
 src/models/qwen4exp.cpp | 40 ++++++++++++++++++++++++++++++++++++----
 2 files changed, 64 insertions(+), 4 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index b8c7ee393f4970e990897f6313bdd4c5f51d476f..646733341bdb9c0d02cb93e09ba973f938f1896e 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -16,6 +16,7 @@
 #include <cinttypes>
 #include <cmath>
 #include <cstring>
+#include <cstdlib>
 #include <limits>
 #include <stdexcept>
 #include <string>
@@ -160,6 +161,33 @@ llama_context::llama_context(
         }
     }
 
+    if (model.arch == LLM_ARCH_QWEN4EXP &&
+        (model.tok_embd == nullptr || model.output == nullptr)) {
+        const char * flag = std::getenv("QWEN38_MTP_SHARE_TENSORS");
+        if (flag == nullptr || std::atoi(flag) != 1 ||
+            params.ctx_type != LLAMA_CONTEXT_TYPE_MTP || params.ctx_other == nullptr ||
+            model.tok_embd != nullptr || model.output != nullptr) {
+            throw std::runtime_error("QWEN4EXP: tensorless draft requires QWEN38_MTP_SHARE_TENSORS=1 and -md");
+        }
+        const llama_model & target = *llama_get_model(params.ctx_other);
+        if (&target == &model || target.arch != LLM_ARCH_QWEN4EXP ||
+            target.hparams.n_embd != model.hparams.n_embd ||
+            target.vocab.n_tokens() != model.vocab.n_tokens()) {
+            throw std::runtime_error("QWEN4EXP: incompatible shared target model");
+        }
+        for (ggml_tensor * tensor : {target.tok_embd, target.output}) {
+            if (tensor == nullptr || tensor->buffer == nullptr ||
+                tensor->ne[0] != model.hparams.n_embd || tensor->ne[1] != model.vocab.n_tokens() ||
+                tensor->ne[2] != 1 || tensor->ne[3] != 1) {
+                throw std::runtime_error("QWEN4EXP: invalid borrowed embedding/head");
+            }
+            LLAMA_LOG_INFO("QWEN38_MTP_SHARE_TENSORS borrowed %s type=%s bytes=%zu buffer=%s\n",
+                    tensor->name, ggml_type_name(tensor->type), ggml_nbytes(tensor),
+                    ggml_backend_buffer_name(tensor->buffer));
+        }
+        cparams.ctx_other = params.ctx_other;
+    }
+
     auto rope_scaling_type = params.rope_scaling_type;
     if (rope_scaling_type == LLAMA_ROPE_SCALING_TYPE_UNSPECIFIED) {
         rope_scaling_type = hparams.rope_scaling_type_train;
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 7a01623a296c79162832866b03921327d540960d..bd67a4f88ea83602fae2b2392d41bfd6bd1a484f 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -4,6 +4,35 @@
 #include "llama-memory-recurrent.h"
 
 #include <algorithm>
+#include <cstdlib>
+#include <stdexcept>
+
+// Isolated adaptation of upstream cc2c59a74; disabled for ordinary sidecars.
+static bool qwen38_mtp_sharing_enabled() {
+    const char * value = std::getenv("QWEN38_MTP_SHARE_TENSORS");
+    return value != nullptr && std::atoi(value) == 1;
+}
+
+static const llama_model & qwen38_mtp_shared_model(
+        const llama_cparams & cparams, const llama_model & model) {
+    if (!qwen38_mtp_sharing_enabled() || cparams.ctx_type != LLAMA_CONTEXT_TYPE_MTP ||
+        cparams.ctx_other == nullptr || model.tok_embd != nullptr || model.output != nullptr) {
+        throw std::runtime_error("QWEN4EXP: tensorless MTP requires explicit sharing and its target context");
+    }
+    const llama_model & other = *llama_get_model(cparams.ctx_other);
+    if (&other == &model || other.arch != LLM_ARCH_QWEN4EXP ||
+        other.hparams.n_embd != model.hparams.n_embd ||
+        other.vocab.n_tokens() != model.vocab.n_tokens()) {
+        throw std::runtime_error("QWEN4EXP: incompatible target for shared MTP tensors");
+    }
+    for (ggml_tensor * tensor : {other.tok_embd, other.output}) {
+        if (tensor == nullptr || tensor->ne[0] != model.hparams.n_embd ||
+            tensor->ne[1] != model.vocab.n_tokens() || tensor->ne[2] != 1 || tensor->ne[3] != 1) {
+            throw std::runtime_error("QWEN4EXP: missing or incompatible borrowed tensor shape");
+        }
+    }
+    return other;
+}
 
 void llama_model_qwen4exp::load_arch_hparams(llama_model_loader & ml) {
     // NextN/MTP (same convention as qwen35): the GGUF block count includes the MTP
@@ -95,7 +124,8 @@ void llama_model_qwen4exp::load_arch_tensors(llama_model_loader & ml) {
     const bool mtp_only = (hparams.n_layer_nextn > 0) && (ml.get_weight("blk.0.hc_attn_norm.weight") == nullptr);
     const int tf        = mtp_only ? TENSOR_NOT_REQUIRED : 0;
 
-    tok_embd = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), { n_embd, n_vocab }, 0);
+    tok_embd = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), { n_embd, n_vocab },
+            mtp_only && qwen38_mtp_sharing_enabled() ? TENSOR_NOT_REQUIRED : 0);
 
     // there is no output_norm: the final hyper-connection mixer carries it
     hc_head_norm = create_tensor(tn(LLM_TENSOR_HC_HEAD_NORM, "weight"), { hc_dim }, tf);
@@ -103,7 +133,7 @@ void llama_model_qwen4exp::load_arch_tensors(llama_model_loader & ml) {
     hc_head_up   = create_tensor(tn(LLM_TENSOR_HC_HEAD_UP,   "weight"), { hc_lr, hc_dim }, tf);
 
     output = create_tensor(tn(LLM_TENSOR_OUTPUT, "weight"), { n_embd, n_vocab }, TENSOR_NOT_REQUIRED);
-    if (output == NULL) {
+    if (output == nullptr && tok_embd != nullptr) {
         output = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), { n_embd, n_vocab }, TENSOR_DUPLICATED);
     }
 
@@ -287,7 +317,8 @@ llama_model_qwen4exp::graph_mtp::graph_mtp(const llama_model & model, const llm_
 
     ggml_tensor * tok_embd;
     if (ubatch.token) {
-        tok_embd = ggml_get_rows(ctx0, model.tok_embd, inp->tokens);
+        const llama_model & embedding_model = model.tok_embd ? model : qwen38_mtp_shared_model(cparams, model);
+        tok_embd = ggml_get_rows(ctx0, embedding_model.tok_embd, inp->tokens);
     } else {
         tok_embd = inp->embd;
     }
@@ -498,7 +529,8 @@ llama_model_qwen4exp::graph_mtp::graph_mtp(const llama_model & model, const llm_
         final = ggml_get_rows(ctx0, final, inp_out_ids);
     }
 
-    ggml_tensor * logits = build_lora_mm(model.output, final, model.output_s);
+    const llama_model & output_model = model.output ? model : qwen38_mtp_shared_model(cparams, model);
+    ggml_tensor * logits = build_lora_mm(output_model.output, final, output_model.output_s);
     cb(logits, "result_output", -1);
 
     res->t_logits = logits;
