Subject: [PATCH 10/24] Add default-off narrow Q4 FA invariance path for Qwen38
 SM120 diagnostics

---
 ggml/src/ggml-cuda/fattn.cu | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/ggml/src/ggml-cuda/fattn.cu b/ggml/src/ggml-cuda/fattn.cu
index ab7a3b297c07c43dc2902de425b292167e1f8d11..b3285c7e9981a32fea762441156996ecae9f96fb 100644
--- a/ggml/src/ggml-cuda/fattn.cu
+++ b/ggml/src/ggml-cuda/fattn.cu
@@ -5,6 +5,29 @@
 #include "fattn-vec.cuh"
 #include "fattn.cuh"
 
+// Default-off, model-shape-specific port of upstream PR #28108 (1e2f695).
+// Keep Q4 KV narrow verification on the same reduction family as serial decode.
+static bool qwen38_fa_narrow_q4(const int device, const ggml_tensor * dst) {
+    static const bool enabled = []() {
+        const char * value = getenv("QWEN38_FA_NARROW_Q4");
+        return value != nullptr && atoi(value) == 1;
+    }();
+    if (!enabled) {
+        return false;
+    }
+    const int cc = ggml_cuda_info().devices[device].cc;
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    float max_bias, softcap;
+    memcpy(&max_bias, (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&softcap, (const float *) dst->op_params + 2, sizeof(float));
+    return GGML_CUDA_CC_IS_NVIDIA(cc) && cc >= GGML_CUDA_CC_BLACKWELL &&
+           Q->ne[0] == 256 && Q->ne[1] >= 3 && Q->ne[1] <= 4 && Q->ne[3] == 1 &&
+           K->type == GGML_TYPE_Q4_0 && V->type == GGML_TYPE_Q4_0 &&
+           K->ne[1] % FATTN_KQ_STRIDE == 0 && max_bias == 0.0f && softcap == 0.0f;
+}
+
 template <int DKQ, int DV, int ncols2>
 static void ggml_cuda_flash_attn_ext_mma_f16_switch_ncols1(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     const int cc = ggml_cuda_info().devices[ggml_cuda_get_device()].cc;
@@ -257,6 +280,10 @@ static void ggml_cuda_flash_attn_ext_mma_f16(ggml_backend_cuda_context & ctx, gg
     FATTN_VEC_CASE(256, type_K, type_V)       \
 
 static void ggml_cuda_flash_attn_ext_vec(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    if (qwen38_fa_narrow_q4(ggml_cuda_get_device(), dst)) {
+        ggml_cuda_flash_attn_ext_vec_case_impl<256, 4, GGML_TYPE_Q4_0, GGML_TYPE_Q4_0, false>(ctx, dst);
+        return;
+    }
     ggml_tensor * Q = dst->src[0];
     ggml_tensor * K = dst->src[1];
     ggml_tensor * V = dst->src[2];
@@ -457,6 +484,10 @@ static best_fattn_kernel ggml_cuda_get_best_fattn_kernel(const int device, const
     // 192 satisfies % 64 == 0 but has no vec instance (DKQ != DV); force it onto the MMA path.
     const bool can_use_vector_kernel = Q->ne[0] <= 256 && Q->ne[0] % 64 == 0 && Q->ne[0] != 192 && K->ne[1] % FATTN_KQ_STRIDE == 0;
 
+    if (qwen38_fa_narrow_q4(device, dst)) {
+        return BEST_FATTN_KERNEL_VEC;
+    }
+
     // If Turing tensor cores are available, use them:
     if (turing_mma_available(cc) && Q->ne[0] != 40 && Q->ne[0] != 72) {
         if (can_use_vector_kernel) {
