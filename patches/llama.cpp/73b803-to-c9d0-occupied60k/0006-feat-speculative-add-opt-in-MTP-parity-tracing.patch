+                  ",\"first_shape\":[%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 "]"
+                  ",\"last_shape\":[%" PRId64 ",%" PRId64 ",%" PRId64 ",%" PRId64 "]}\n",
+                  action,
+                  event_id,
+                  cgraph->n_nodes,
+                  (unsigned long long) (uintptr_t) graph_key,
+                  first->ne[0], first->ne[1], first->ne[2], first->ne[3],
+                  last->ne[0], last->ne[1], last->ne[2], last->ne[3]);
+}
