+static bool common_sampler_parity_trace_enabled() {
+    static const bool enabled = []() {
+        const char * value = std::getenv("LLAMA_SPEC_PARITY_TRACE");
+        return value != nullptr && std::atoi(value) > 0;
+    }();
+    return enabled;
+}
+
+static std::string common_sampler_trace_float(float value) {
+    if (!std::isfinite(value)) {
+        return "null";
+    }
+
+    char buf[32];
+    std::snprintf(buf, sizeof(buf), "%.9g", (double) value);
+    return buf;
+}
+
+static std::atomic<uint64_t> common_sampler_trace_event_id { 0 };
+static thread_local int32_t  common_sampler_trace_seq_id     = -1;
+static thread_local uint64_t common_sampler_trace_round      = 0;
+static thread_local int64_t  common_sampler_trace_request_id = -1;
+
 // the ring buffer works similarly to std::deque, but with a fixed capacity
 // TODO: deduplicate with llama-impl.h
 template<typename T>
@@ -121,6 +149,13 @@ struct common_sampler {
 
     llama_token_data_array cur_p;
 
+    // Raw (pre-sampler) top-2 logits for the parity trace. These are populated
+    // only when LLAMA_SPEC_PARITY_TRACE=1 and never participate in sampling.
+    llama_token trace_raw_top1_id = LLAMA_TOKEN_NULL;
+    llama_token trace_raw_top2_id = LLAMA_TOKEN_NULL;
+    float       trace_raw_top1_logit = -INFINITY;
+    float       trace_raw_top2_logit = -INFINITY;
+
     void reset() {
         prev.clear();
 
@@ -158,6 +193,29 @@ struct common_sampler {
             }
         }
 
+        if (common_sampler_parity_trace_enabled()) {
+            trace_raw_top1_id = LLAMA_TOKEN_NULL;
+            trace_raw_top2_id = LLAMA_TOKEN_NULL;
+            trace_raw_top1_logit = -INFINITY;
+            trace_raw_top2_logit = -INFINITY;
+
+            for (const auto & candidate : cur) {
+                const float logit = candidate.logit;
+                if (!std::isfinite(logit)) {
+                    continue;
+                }
+                if (logit > trace_raw_top1_logit) {
+                    trace_raw_top2_id = trace_raw_top1_id;
+                    trace_raw_top2_logit = trace_raw_top1_logit;
+                    trace_raw_top1_id = candidate.id;
+                    trace_raw_top1_logit = logit;
+                } else if (logit > trace_raw_top2_logit) {
+                    trace_raw_top2_id = candidate.id;
+                    trace_raw_top2_logit = logit;
+                }
+            }
+        }
+
         cur_p = { cur.data(), cur.size(), -1, false };
     }
 
@@ -675,6 +733,58 @@ llama_token common_sampler_sample(struct common_sampler * gsmpl, struct llama_co
     return id;
 }
 
+void common_sampler_set_trace_context(int32_t seq_id, uint64_t round, int64_t request_id) {
+    common_sampler_trace_seq_id = seq_id;
+    common_sampler_trace_round = round;
+    common_sampler_trace_request_id = request_id;
+}
+
+void common_sampler_clear_trace_context() {
+    common_sampler_trace_seq_id = -1;
+    common_sampler_trace_round = 0;
+    common_sampler_trace_request_id = -1;
+}
+
+static void common_sampler_trace_verify(
+        const common_sampler * gsmpl,
+        int idx,
+        llama_token draft_token,
+        llama_token target_token,
+        size_t draft_index,
+        bool has_draft) {
+    if (!common_sampler_parity_trace_enabled()) {
+        return;
+    }
+
+    const float margin = std::isfinite(gsmpl->trace_raw_top1_logit) &&
+            std::isfinite(gsmpl->trace_raw_top2_logit)
+        ? gsmpl->trace_raw_top1_logit - gsmpl->trace_raw_top2_logit
+        : NAN;
+
+    const uint64_t event_id = common_sampler_trace_event_id.fetch_add(1, std::memory_order_relaxed) + 1;
+    LOG_INF("mtp_trace_json {\"event\":\"target_verify\",\"event_id\":%" PRIu64
+            ",\"request_id\":%" PRId64 ",\"seq_id\":%d,\"round\":%" PRIu64
+            ",\"idx\":%d,\"draft_index\":%zu,\"has_draft\":%s"
+            ",\"draft_token\":%d,\"target_token\":%d,\"match\":%s"
+            ",\"raw_top1_id\":%d,\"raw_top1_logit\":%s"
+            ",\"raw_top2_id\":%d,\"raw_top2_logit\":%s,\"raw_margin\":%s}\n",
+            event_id,
+            common_sampler_trace_request_id,
+            common_sampler_trace_seq_id,
+            common_sampler_trace_round,
+            idx,
+            draft_index,
+            has_draft ? "true" : "false",
+            (int) draft_token,
+            (int) target_token,
+            has_draft && draft_token == target_token ? "true" : "false",
+            (int) gsmpl->trace_raw_top1_id,
+            common_sampler_trace_float(gsmpl->trace_raw_top1_logit).c_str(),
+            (int) gsmpl->trace_raw_top2_id,
+            common_sampler_trace_float(gsmpl->trace_raw_top2_logit).c_str(),
+            common_sampler_trace_float(margin).c_str());
+}
+
