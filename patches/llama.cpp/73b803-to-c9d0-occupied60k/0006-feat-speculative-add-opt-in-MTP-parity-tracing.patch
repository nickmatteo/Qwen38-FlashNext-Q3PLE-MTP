+
+static uint64_t common_speculative_trace_checksum(const float * data, size_t count) {
+    // FNV-1a over the exact float bit patterns. This is deliberately cheap and
+    // stable across runs without touching device state or forcing a sync.
+    uint64_t hash = 1469598103934665603ULL;
+    for (size_t i = 0; i < count; ++i) {
+        uint32_t bits = 0;
+        std::memcpy(&bits, data + i, sizeof(bits));
+        hash ^= bits;
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+static std::atomic<uint64_t> common_speculative_trace_event_id { 0 };
