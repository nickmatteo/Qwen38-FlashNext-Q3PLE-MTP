     GGML_ASSERT(idxs.size() == draft.size() + 1 && "idxs.size() must be draft.size() + 1");
 
@@ -685,6 +795,8 @@ std::vector<llama_token> common_sampler_sample_and_accept_n(struct common_sample
     for (; i < draft.size(); i++) {
         const llama_token id = common_sampler_sample(gsmpl, ctx, idxs[i], grammar_first);
 
+        common_sampler_trace_verify(gsmpl, idxs[i], draft[i], id, i, true);
+
         common_sampler_accept(gsmpl, id, true);
 
         result.push_back(id);
@@ -697,6 +809,8 @@ std::vector<llama_token> common_sampler_sample_and_accept_n(struct common_sample
     if (i == draft.size()) {
         const llama_token id = common_sampler_sample(gsmpl, ctx, idxs[i], grammar_first);
 
+        common_sampler_trace_verify(gsmpl, idxs[i], LLAMA_TOKEN_NULL, id, i, false);
+
         common_sampler_accept(gsmpl, id, true);
 
         result.push_back(id);
