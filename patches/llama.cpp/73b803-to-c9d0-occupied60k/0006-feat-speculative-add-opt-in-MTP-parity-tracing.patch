+static void ggml_cuda_graph_trace_emit(const char * action, const ggml_cgraph * cgraph, const void * graph_key) {
+    if (!ggml_cuda_graph_trace_enabled() || cgraph == nullptr || cgraph->n_nodes <= 0) {
+        return;
+    }
+
+    const ggml_tensor * first = cgraph->nodes[0];
+    const ggml_tensor * last  = cgraph->nodes[cgraph->n_nodes - 1];
+    const uint64_t event_id = ggml_cuda_graph_trace_event_id.fetch_add(1, std::memory_order_relaxed) + 1;
