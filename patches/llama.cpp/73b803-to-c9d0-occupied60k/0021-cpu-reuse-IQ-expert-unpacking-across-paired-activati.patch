Subject: [PATCH 21/24] cpu: reuse IQ expert unpacking across paired activation
 rows

Assisted-by: ChatGPT
---
 ggml/src/ggml-cpu/arch/x86/quants.c | 265 ++++++++++++++++++++++++++++
 ggml/src/ggml-cpu/ggml-cpu.c        |  38 ++++
 ggml/src/ggml-cpu/quants.h          |   5 +
 3 files changed, 308 insertions(+)

diff --git a/ggml/src/ggml-cpu/arch/x86/quants.c b/ggml/src/ggml-cpu/arch/x86/quants.c
index ea54cfe44ce403fe06c8b4aa10b5a882779e7e71..75b56beaf26254471827ef64309dd339283f665f 100644
--- a/ggml/src/ggml-cpu/arch/x86/quants.c
+++ b/ggml/src/ggml-cpu/arch/x86/quants.c
@@ -4106,3 +4106,268 @@ void ggml_vec_dot_iq4_xs_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const v
     ggml_vec_dot_iq4_xs_q8_K_generic(n, s, bs, vx, bx, vy, by, nrc);
 #endif
 }
+
+// Paired rows share only weight unpacking, never output accumulators.
+void qwen38_ggml_vec_dot_iq2_s_q8_K_pair(int n, float * s0, float * s1, const void * vx, const void * vy0, const void * vy1) {
+    GGML_ASSERT(n > 0 && n % QK_K == 0);
+    const block_iq2_s * x = vx;
+    const block_q8_K * y0 = vy0, * y1 = vy1;
+    const int nb = n / QK_K;
+#if defined(__AVX2__)
+
+   static const uint8_t k_mask1[32] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+                                       0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03
+   };
+
+    static const uint8_t k_mask2[32] = {0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80,
+                                        0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80,
+    };
+
+    const __m128i m4 = _mm_set1_epi8(0xf);
+    const __m128i m1 = _mm_set1_epi8(1);
+
+    const __m256i mask1 = _mm256_loadu_si256((const __m256i*)k_mask1);
+    const __m256i mask2 = _mm256_loadu_si256((const __m256i*)k_mask2);
+
+    uint64_t aux64;
+
+    __m256 accumf0 = _mm256_setzero_ps();
+    __m256 accumf1 = _mm256_setzero_ps();
+    for (int i = 0; i < nb; ++i) {
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d0) * y0[i].d0;
+        const float d1 = GGML_CPU_FP16_TO_FP32(x[i].d1) * y1[i].d1;
+        const uint8_t * GGML_RESTRICT qs = x[i].qs;
+        const uint8_t * GGML_RESTRICT qh = x[i].qh;
+        const uint16_t * GGML_RESTRICT signs = (const uint16_t *)(x[i].qs + QK_K/8);
+        const int8_t  * GGML_RESTRICT q80 = y0[i].qs;
+        const int8_t  * GGML_RESTRICT q81 = y1[i].qs;
+
+        memcpy(&aux64, x[i].scales, 8);
+        const __m128i scales8 = _mm_add_epi8(_mm_slli_epi16(_mm_and_si128(_mm_set_epi64x(aux64 >> 4, aux64), m4), 1), m1);
+        const __m256i scales16 = _mm256_cvtepi8_epi16(scales8); // 0 2 4 6 8 10 12 14 1 3 5 7 9 11 13 15
+
+        __m256i sumi10 = _mm256_setzero_si256();
+        __m256i sumi11 = _mm256_setzero_si256();
+        __m256i sumi20 = _mm256_setzero_si256();
+        __m256i sumi21 = _mm256_setzero_si256();
+        for (int ib32 = 0; ib32 < QK_K/32; ib32 += 2) {
+            const __m256i q8_10 = _mm256_loadu_si256((const __m256i *)q80); q80 += 32;
+            const __m256i q8_11 = _mm256_loadu_si256((const __m256i *)q81); q81 += 32;
+            const __m256i q8_20 = _mm256_loadu_si256((const __m256i *)q80); q80 += 32;
+            const __m256i q8_21 = _mm256_loadu_si256((const __m256i *)q81); q81 += 32;
+            const __m256i q2_1 = _mm256_set_epi64x(iq2s_grid[qs[3] | ((qh[ib32+0] << 2) & 0x300)],
+                                                   iq2s_grid[qs[2] | ((qh[ib32+0] << 4) & 0x300)],
+                                                   iq2s_grid[qs[1] | ((qh[ib32+0] << 6) & 0x300)],
+                                                   iq2s_grid[qs[0] | ((qh[ib32+0] << 8) & 0x300)]);
+            const __m256i q2_2 = _mm256_set_epi64x(iq2s_grid[qs[7] | ((qh[ib32+1] << 2) & 0x300)],
+                                                   iq2s_grid[qs[6] | ((qh[ib32+1] << 4) & 0x300)],
+                                                   iq2s_grid[qs[5] | ((qh[ib32+1] << 6) & 0x300)],
+                                                   iq2s_grid[qs[4] | ((qh[ib32+1] << 8) & 0x300)]);
+            qs += 8;
+
+            __m256i aux256 = _mm256_set1_epi32(signs[0] | ((uint32_t) signs[1] << 16));
+            aux256 = _mm256_and_si256(_mm256_shuffle_epi8(aux256,mask1), mask2);
+            const __m256i s2_1 = _mm256_cmpeq_epi8(aux256, mask2);
+            const __m256i q8s_10 = _mm256_sub_epi8(_mm256_xor_si256(s2_1, q8_10), s2_1);
+            const __m256i q8s_11 = _mm256_sub_epi8(_mm256_xor_si256(s2_1, q8_11), s2_1);
+
+            aux256 = _mm256_set1_epi32(signs[2] | ((uint32_t) signs[3] << 16));
+            aux256 = _mm256_and_si256(_mm256_shuffle_epi8(aux256,mask1), mask2);
+            const __m256i s2_2 = _mm256_cmpeq_epi8(aux256, mask2);
+            const __m256i q8s_20 = _mm256_sub_epi8(_mm256_xor_si256(s2_2, q8_20), s2_2);
+            const __m256i q8s_21 = _mm256_sub_epi8(_mm256_xor_si256(s2_2, q8_21), s2_2);
+
+            signs += 4;
+
+            const __m256i dot10  = _mm256_maddubs_epi16(q2_1, q8s_10); // blocks 2*ib32+0, 2*ib32+1
+            const __m256i dot11  = _mm256_maddubs_epi16(q2_1, q8s_11); // blocks 2*ib32+0, 2*ib32+1
+            const __m256i dot20  = _mm256_maddubs_epi16(q2_2, q8s_20); // blocks 2*ib32+2, 2*ib32+3
+            const __m256i dot21  = _mm256_maddubs_epi16(q2_2, q8s_21); // blocks 2*ib32+2, 2*ib32+3
+
+            const __m256i p10 = _mm256_madd_epi16(dot10, _mm256_shuffle_epi8(scales16, get_scale_shuffle_k4(ib32+0)));
+            const __m256i p11 = _mm256_madd_epi16(dot11, _mm256_shuffle_epi8(scales16, get_scale_shuffle_k4(ib32+0)));
+            const __m256i p20 = _mm256_madd_epi16(dot20, _mm256_shuffle_epi8(scales16, get_scale_shuffle_k4(ib32+1)));
+            const __m256i p21 = _mm256_madd_epi16(dot21, _mm256_shuffle_epi8(scales16, get_scale_shuffle_k4(ib32+1)));
+            sumi10 = _mm256_add_epi32(sumi10, p10);
+            sumi11 = _mm256_add_epi32(sumi11, p11);
+            sumi20 = _mm256_add_epi32(sumi20, p20);
+            sumi21 = _mm256_add_epi32(sumi21, p21);
+        }
+
+        accumf0 = _mm256_fmadd_ps(_mm256_set1_ps(d0), _mm256_cvtepi32_ps(_mm256_add_epi32(sumi10, sumi20)), accumf0);
+        accumf1 = _mm256_fmadd_ps(_mm256_set1_ps(d1), _mm256_cvtepi32_ps(_mm256_add_epi32(sumi11, sumi21)), accumf1);
+
+    }
+
+    *s0 = 0.125f * hsum_float_8(accumf0);
+    *s1 = 0.125f * hsum_float_8(accumf1);
+
+#else
+    ggml_vec_dot_iq2_s_q8_K(n,s0,0,vx,0,vy0,0,1); ggml_vec_dot_iq2_s_q8_K(n,s1,0,vx,0,vy1,0,1);
+#endif
+}
+
+void qwen38_ggml_vec_dot_iq3_s_q8_K_pair(int n, float * s0, float * s1, const void * vx, const void * vy0, const void * vy1) {
+    GGML_ASSERT(n > 0 && n % QK_K == 0);
+    const block_iq3_s * x = vx;
+    const block_q8_K * y0 = vy0, * y1 = vy1;
+    const int nb = n / QK_K;
+#if defined(__AVX2__)
+
+   static const uint8_t k_mask1[32] = {0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
+                                       0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03, 0x03
+   };
+
+    static const uint8_t k_mask2[32] = {0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80,
+                                        0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80,
+    };
+
+    const __m256i mask1 = _mm256_loadu_si256((const __m256i*)k_mask1);
+    const __m256i mask2 = _mm256_loadu_si256((const __m256i*)k_mask2);
+
+    const __m256i idx_shift = _mm256_set_epi32(1, 2, 3, 4, 5, 6, 7, 8);
+    const __m256i idx_mask  = _mm256_set1_epi32(256);
+
+    typedef union {
+        __m256i  vec[2];
+        uint32_t index[16];
+    } index_t;
+
+    index_t idx;
+
+    __m256 accumf0 = _mm256_setzero_ps();
+    __m256 accumf1 = _mm256_setzero_ps();
+    for (int i = 0; i < nb; ++i) {
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d0) * y0[i].d0;
+        const float d1 = GGML_CPU_FP16_TO_FP32(x[i].d1) * y1[i].d1;
+        const uint8_t * GGML_RESTRICT qs = x[i].qs;
+        const uint8_t * GGML_RESTRICT qh = x[i].qh;
+        const uint16_t * GGML_RESTRICT signs = (const uint16_t *)x[i].signs;
+        const int8_t  * GGML_RESTRICT q80 = y0[i].qs;
+        const int8_t  * GGML_RESTRICT q81 = y1[i].qs;
+        __m256i sumi10 = _mm256_setzero_si256();
+        __m256i sumi11 = _mm256_setzero_si256();
+        __m256i sumi20 = _mm256_setzero_si256();
+        __m256i sumi21 = _mm256_setzero_si256();
+        for (int ib32 = 0; ib32 < QK_K/32; ib32 += 2) {
+            const __m256i q8_10 = _mm256_loadu_si256((const __m256i *)q80); q80 += 32;
+            const __m256i q8_11 = _mm256_loadu_si256((const __m256i *)q81); q81 += 32;
+            const __m256i q8_20 = _mm256_loadu_si256((const __m256i *)q80); q80 += 32;
+            const __m256i q8_21 = _mm256_loadu_si256((const __m256i *)q81); q81 += 32;
+            const __m256i idx_l = _mm256_cvtepu8_epi16(_mm_loadu_si128((const __m128i *)qs)); qs += 16;
+            idx.vec[0] = _mm256_set1_epi32(qh[ib32+0]);
+            idx.vec[1] = _mm256_set1_epi32(qh[ib32+1]);
+            idx.vec[0] = _mm256_and_si256(_mm256_sllv_epi32(idx.vec[0], idx_shift), idx_mask);
+            idx.vec[1] = _mm256_and_si256(_mm256_sllv_epi32(idx.vec[1], idx_shift), idx_mask);
+            idx.vec[0] = _mm256_or_si256(idx.vec[0], _mm256_cvtepi16_epi32(_mm256_castsi256_si128(idx_l)));
+            idx.vec[1] = _mm256_or_si256(idx.vec[1], _mm256_cvtepi16_epi32(_mm256_extractf128_si256(idx_l, 1)));
+
+            // At leat on my CPU (Ryzen 7950X), using _mm256_i32gather_epi32 is slower than _mm256_set_epi32. Strange.
+            //const __m256i q2_1 = _mm256_i32gather_epi32((const int *)iq3s_grid, idx.vec[0], 4);
+            //const __m256i q2_2 = _mm256_i32gather_epi32((const int *)iq3s_grid, idx.vec[1], 4);
+            const __m256i q2_1 = _mm256_set_epi32(
+                    iq3s_grid[idx.index[7]], iq3s_grid[idx.index[6]], iq3s_grid[idx.index[5]], iq3s_grid[idx.index[4]],
+                    iq3s_grid[idx.index[3]], iq3s_grid[idx.index[2]], iq3s_grid[idx.index[1]], iq3s_grid[idx.index[0]]
+            );
+            const __m256i q2_2 = _mm256_set_epi32(
+                    iq3s_grid[idx.index[15]], iq3s_grid[idx.index[14]], iq3s_grid[idx.index[13]], iq3s_grid[idx.index[12]],
+                    iq3s_grid[idx.index[11]], iq3s_grid[idx.index[10]], iq3s_grid[idx.index[ 9]], iq3s_grid[idx.index[ 8]]
+            );
+
+            __m256i aux256 = _mm256_set1_epi32(signs[0] | (signs[1] << 16));
+            aux256 = _mm256_and_si256(_mm256_shuffle_epi8(aux256,mask1), mask2);
+            const __m256i s2_1 = _mm256_cmpeq_epi8(aux256, mask2);
+            const __m256i q8s_10 = _mm256_sub_epi8(_mm256_xor_si256(s2_1, q8_10), s2_1);
+            const __m256i q8s_11 = _mm256_sub_epi8(_mm256_xor_si256(s2_1, q8_11), s2_1);
+
+            aux256 = _mm256_set1_epi32(signs[2] | (signs[3] << 16));
+            aux256 = _mm256_and_si256(_mm256_shuffle_epi8(aux256,mask1), mask2);
+            const __m256i s2_2 = _mm256_cmpeq_epi8(aux256, mask2);
+            const __m256i q8s_20 = _mm256_sub_epi8(_mm256_xor_si256(s2_2, q8_20), s2_2);
+            const __m256i q8s_21 = _mm256_sub_epi8(_mm256_xor_si256(s2_2, q8_21), s2_2);
+
+            signs += 4;
+
+            const __m256i dot10  = _mm256_maddubs_epi16(q2_1, q8s_10);
+            const __m256i dot11  = _mm256_maddubs_epi16(q2_1, q8s_11);
+            const __m256i dot20  = _mm256_maddubs_epi16(q2_2, q8s_20);
+            const __m256i dot21  = _mm256_maddubs_epi16(q2_2, q8s_21);
+            const uint16_t ls1 = x[i].scales[ib32/2] & 0xf;
+            const uint16_t ls2 = x[i].scales[ib32/2] >>  4;
+            const __m256i p10 = _mm256_madd_epi16(dot10, _mm256_set1_epi16(2*ls1+1));
+            const __m256i p11 = _mm256_madd_epi16(dot11, _mm256_set1_epi16(2*ls1+1));
+            const __m256i p20 = _mm256_madd_epi16(dot20, _mm256_set1_epi16(2*ls2+1));
+            const __m256i p21 = _mm256_madd_epi16(dot21, _mm256_set1_epi16(2*ls2+1));
+            sumi10 = _mm256_add_epi32(sumi10, p10);
+            sumi11 = _mm256_add_epi32(sumi11, p11);
+            sumi20 = _mm256_add_epi32(sumi20, p20);
+            sumi21 = _mm256_add_epi32(sumi21, p21);
+        }
+
+        accumf0 = _mm256_fmadd_ps(_mm256_set1_ps(d0), _mm256_cvtepi32_ps(_mm256_add_epi32(sumi10, sumi20)), accumf0);
+        accumf1 = _mm256_fmadd_ps(_mm256_set1_ps(d1), _mm256_cvtepi32_ps(_mm256_add_epi32(sumi11, sumi21)), accumf1);
+
+    }
+
+    *s0 = hsum_float_8(accumf0);
+    *s1 = hsum_float_8(accumf1);
+
+#else
+    ggml_vec_dot_iq3_s_q8_K(n,s0,0,vx,0,vy0,0,1); ggml_vec_dot_iq3_s_q8_K(n,s1,0,vx,0,vy1,0,1);
+#endif
+}
+
+void qwen38_ggml_vec_dot_iq4_nl_q8_0_pair(int n, float * s0, float * s1, const void * vx, const void * vy0, const void * vy1) {
+    if (n % 64 != 0) { ggml_vec_dot_iq4_nl_q8_0(n,s0,0,vx,0,vy0,0,1); ggml_vec_dot_iq4_nl_q8_0(n,s1,0,vx,0,vy1,0,1); return; }
+    GGML_ASSERT(n > 0 && n % 32 == 0);
+    const block_iq4_nl * x = vx;
+    const block_q8_0 * y0 = vy0, * y1 = vy1;
+    const int nb = n / QK4_NL;
+#if defined(__AVX2__)
+    int ib = 0; float sumf0 = 0, sumf1 = 0;
+
+    const __m128i values128 = _mm_loadu_si128((const __m128i*)kvalues_iq4nl);
+    const __m128i m4b  = _mm_set1_epi8(0x0f);
+    const __m256i mone = _mm256_set1_epi16(1);
+
+    __m256 accum10 = _mm256_setzero_ps();
+    __m256 accum11 = _mm256_setzero_ps();
+    __m256 accum20 = _mm256_setzero_ps();
+    __m256 accum21 = _mm256_setzero_ps();
+    for (; ib + 1 < nb; ib += 2) {
+        const __m128i q4bits_1 = _mm_loadu_si128((const __m128i*)x[ib + 0].qs);
+        const __m128i q4bits_2 = _mm_loadu_si128((const __m128i*)x[ib + 1].qs);
+        const __m256i q8b_10 = _mm256_loadu_si256((const __m256i *)y0[ib + 0].qs);
+        const __m256i q8b_11 = _mm256_loadu_si256((const __m256i *)y1[ib + 0].qs);
+        const __m256i q8b_20 = _mm256_loadu_si256((const __m256i *)y0[ib + 1].qs);
+        const __m256i q8b_21 = _mm256_loadu_si256((const __m256i *)y1[ib + 1].qs);
+        const __m256i q4b_1 = MM256_SET_M128I(_mm_shuffle_epi8(values128, _mm_and_si128(_mm_srli_epi16(q4bits_1, 4), m4b)),
+                                              _mm_shuffle_epi8(values128, _mm_and_si128(q4bits_1, m4b)));
+        const __m256i q4b_2 = MM256_SET_M128I(_mm_shuffle_epi8(values128, _mm_and_si128(_mm_srli_epi16(q4bits_2, 4), m4b)),
+                                              _mm_shuffle_epi8(values128, _mm_and_si128(q4bits_2, m4b)));
+        const __m256i p16_10 = mul_add_epi8(q4b_1, q8b_10);
+        const __m256i p16_11 = mul_add_epi8(q4b_1, q8b_11);
+        const __m256i p16_20 = mul_add_epi8(q4b_2, q8b_20);
+        const __m256i p16_21 = mul_add_epi8(q4b_2, q8b_21);
+        const __m256i p_10 = _mm256_madd_epi16(p16_10, mone);
+        const __m256i p_11 = _mm256_madd_epi16(p16_11, mone);
+        const __m256i p_20 = _mm256_madd_epi16(p16_20, mone);
+        const __m256i p_21 = _mm256_madd_epi16(p16_21, mone);
+        accum10 = _mm256_fmadd_ps(_mm256_set1_ps(GGML_CPU_FP16_TO_FP32(y0[ib + 0].d)*GGML_CPU_FP16_TO_FP32(x[ib + 0].d)),
+                _mm256_cvtepi32_ps(p_10), accum10);
+        accum11 = _mm256_fmadd_ps(_mm256_set1_ps(GGML_CPU_FP16_TO_FP32(y1[ib + 0].d)*GGML_CPU_FP16_TO_FP32(x[ib + 0].d)),
+                _mm256_cvtepi32_ps(p_11), accum11);
+        accum20 = _mm256_fmadd_ps(_mm256_set1_ps(GGML_CPU_FP16_TO_FP32(y0[ib + 1].d)*GGML_CPU_FP16_TO_FP32(x[ib + 1].d)),
+                _mm256_cvtepi32_ps(p_20), accum20);
+        accum21 = _mm256_fmadd_ps(_mm256_set1_ps(GGML_CPU_FP16_TO_FP32(y1[ib + 1].d)*GGML_CPU_FP16_TO_FP32(x[ib + 1].d)),
+                _mm256_cvtepi32_ps(p_21), accum21);
+    }
+
+    sumf0 = hsum_float_8(_mm256_add_ps(accum10, accum20));
+    sumf1 = hsum_float_8(_mm256_add_ps(accum11, accum21));
+
+    *s0 = sumf0; *s1 = sumf1;
+#else
+    ggml_vec_dot_iq4_nl_q8_0(n,s0,0,vx,0,vy0,0,1); ggml_vec_dot_iq4_nl_q8_0(n,s1,0,vx,0,vy1,0,1);
+#endif
+}
diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index e6c7f5d8daa540dd58b331b180cf8cdb45dbabd5..da3348960a496d065e6368e3aea9e30ee548a06c 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
