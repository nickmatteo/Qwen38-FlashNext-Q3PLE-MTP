Subject: [PATCH 05/24] perf(speculative): expose MTP phase timing diagnostics

---
 common/speculative.cpp          | 20 +++++++++
 tools/server/server-context.cpp | 72 +++++++++++++++++++++++++++++++++
 2 files changed, 92 insertions(+)

diff --git a/common/speculative.cpp b/common/speculative.cpp
index d80e5ca89f3c5180a30e376cb731047ba01e7f0e..9c93ab7946ca026fae6778218a0609f2a4107fea 100644
--- a/common/speculative.cpp
+++ b/common/speculative.cpp
@@ -14,6 +14,7 @@
 
 #include <algorithm>
 #include <cassert>
