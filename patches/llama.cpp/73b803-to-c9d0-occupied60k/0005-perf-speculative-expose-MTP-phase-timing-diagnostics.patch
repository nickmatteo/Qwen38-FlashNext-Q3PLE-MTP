 #include <cstring>
 #include <iomanip>
 #include <map>
@@ -29,6 +30,14 @@
 #define SPEC_VOCAB_MAX_SIZE_DIFFERENCE  128
 #define SPEC_VOCAB_CHECK_START_TOKEN_ID 5
 
+static bool common_speculative_timing_enabled() {
+    static const bool enabled = []() {
+        const char * value = std::getenv("LLAMA_SPEC_TIMING");
+        return value != nullptr && std::atoi(value) > 0;
+    }();
+    return enabled;
+}
+
 const std::map<std::string, common_speculative_type> common_speculative_type_from_name_map = {
     {"none",          COMMON_SPECULATIVE_TYPE_NONE},
     {"draft-simple",  COMMON_SPECULATIVE_TYPE_DRAFT_SIMPLE},
@@ -1515,7 +1524,18 @@ struct common_speculative_impl_draft_mtp : public common_speculative_impl {
                     llama_set_nextn_layer_offset(ctx_dft, head);
                 }
 
+                const bool timing_enabled = common_speculative_timing_enabled();
+                const int32_t timed_batch_tokens = batch.n_tokens;
+                const int64_t t_catchup_start = timing_enabled ? ggml_time_us() : 0;
                 const int32_t rc = llama_decode(ctx_dft, batch);
+                if (rc == 0 && timing_enabled) {
+                    // The catch-up decode is normally allowed to stay asynchronous until
+                    // the next draft consumes its state. Synchronize only in the explicit
+                    // diagnostic lane so its cost cannot bleed into the following draft.
+                    llama_synchronize(ctx_dft);
+                    SPC_INF("mtp_timing_json {\"phase\":\"draft_catchup\",\"head\":%d,\"batch_tokens\":%d,\"elapsed_us\":%" PRId64 "}\n",
+                            head, timed_batch_tokens, ggml_time_us() - t_catchup_start);
+                }
                 if (rc != 0) {
                     SPC_ERR("llama_decode(ctx_dft) head=%d failed rc=%d (pos=%d)\n",
                             head, (int) rc, (int) batch_in.pos[0]);
