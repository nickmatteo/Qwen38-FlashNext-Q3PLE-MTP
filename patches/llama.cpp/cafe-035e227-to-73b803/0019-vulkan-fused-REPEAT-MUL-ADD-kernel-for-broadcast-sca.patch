 static bool ggml_vk_can_fuse_snake(ggml_backend_vk_context * ctx, const struct ggml_cgraph * cgraph, int node_idx) {
     GGML_UNUSED(ctx);
     if (!ggml_can_fuse(cgraph, node_idx, snake_pattern)) {
@@ -17455,6 +17607,15 @@ static ggml_status ggml_backend_vk_graph_compute(ggml_backend_t backend, ggml_cg
                 op_srcs_fused_elementwise[0] = false;
                 op_srcs_fused_elementwise[1] = false;
                 op_srcs_fused_elementwise[2] = false;
+            } else if (int mba_span = 0; ggml_vk_can_fuse_mul_bcast_add(ctx, cgraph, i, &mba_span)) {
+                ctx->num_additional_fused_ops = mba_span;
+                fusion_string = "REPEAT_MUL_ADD";
+                // elementwise=true: the shader reads data_r[idx] into a register before
+                // writing data_d[idx], so the common in-place case (residual buffer reused
+                // for the output) is safe under exact aliasing. The broadcast operands can
+                // never exactly alias the (larger) output, so partial overlaps still
+                // disable fusion via the overlap check.
+                std::fill_n(op_srcs_fused_elementwise, mba_span + 1, true);
             } else if (ggml_vk_can_fuse_snake(ctx, cgraph, i)) {
                 ctx->num_additional_fused_ops = 4;
                 fusion_string = "SNAKE";
@@ -17762,6 +17923,12 @@ static void ggml_vk_graph_optimize(ggml_backend_t backend, struct ggml_cgraph *
         if (keep_pattern(snake_pattern)) {
             continue;
         }
+        if (keep_pattern(mul_bcast_add_pattern)) {
+            continue;
+        }
+        if (keep_pattern(mul_bcast_add_pattern_novw)) {
+            continue;
+        }
 
         // First, grab the next unused node.
         current_set.push_back(first_unused);
@@ -17813,7 +17980,9 @@ static void ggml_vk_graph_optimize(ggml_backend_t backend, struct ggml_cgraph *
                 match_pattern(topk_moe_sqrt_softplus_norm_bias, j) ||
                 match_pattern(topk_moe_early_softmax, j) ||
                 match_pattern(topk_moe_late_softmax, j) ||
-                match_pattern(snake_pattern, j)) {
+                match_pattern(snake_pattern, j) ||
+                match_pattern(mul_bcast_add_pattern, j) ||
+                match_pattern(mul_bcast_add_pattern_novw, j)) {
                 continue;
             }
             bool ok = true;
diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/mul_bcast_add.comp b/ggml/src/ggml-vulkan/vulkan-shaders/mul_bcast_add.comp
new file mode 100644
index 000000000..fc53f6da1
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/mul_bcast_add.comp
@@ -0,0 +1,39 @@
+#version 450
+
+#extension GL_EXT_control_flow_attributes : enable
+
+// Fused REPEAT + MUL + ADD:  dst = r + repeat(a) * repeat(w)
+// a and w broadcast onto dst's shape, r matches dst exactly. All f32,
+// all contiguous. Used for the hyper-connection combine scatter.
+
+layout (push_constant) uniform parameter
+{
+    uint ne;
+    uint ne0;   uint ne1;   uint ne2;   uint ne3;
+    uint a_ne0; uint a_ne1; uint a_ne2; uint a_ne3;
+    uint w_ne0; uint w_ne1; uint w_ne2; uint w_ne3;
+} p;
+
+layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly  buffer A {float data_a[];};
+layout (binding = 1) readonly  buffer W {float data_w[];};
+layout (binding = 2) readonly  buffer R {float data_r[];};
+layout (binding = 3) writeonly buffer D {float data_d[];};
+
+void main() {
+    const uint idx = gl_GlobalInvocationID.x;
+    if (idx >= p.ne) {
+        return;
+    }
+
+    const uint i0 =  idx % p.ne0;
+    const uint i1 = (idx / p.ne0) % p.ne1;
+    const uint i2 = (idx / (p.ne0 * p.ne1)) % p.ne2;
+    const uint i3 =  idx / (p.ne0 * p.ne1 * p.ne2);
+
+    const uint ia = (i0 % p.a_ne0) + p.a_ne0 * ((i1 % p.a_ne1) + p.a_ne1 * ((i2 % p.a_ne2) + p.a_ne2 * (i3 % p.a_ne3)));
+    const uint iw = (i0 % p.w_ne0) + p.w_ne0 * ((i1 % p.w_ne1) + p.w_ne1 * ((i2 % p.w_ne2) + p.w_ne2 * (i3 % p.w_ne3)));
+
+    data_d[idx] = data_r[idx] + data_a[ia] * data_w[iw];
+}
