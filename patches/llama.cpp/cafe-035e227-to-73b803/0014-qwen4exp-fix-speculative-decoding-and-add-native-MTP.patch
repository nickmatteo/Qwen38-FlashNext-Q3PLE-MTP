+            # the head's own hyper-connection mixer in place of shared_head.norm
+            if len(parts) == 4 and parts[1] == "hyper_connection_mixer":
+                return f"model.layers.{obc}.hc_mixer_mtp.{parts[2]}.{parts[3]}", item[1]
